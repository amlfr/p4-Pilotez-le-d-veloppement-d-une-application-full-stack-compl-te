# Copier ce fichier vers .env et remplir les valeurs (jamais commité).
# Chargé au démarrage via spring.config.import ; une vraie variable
# d'environnement a priorité si les deux existent.

# Mot de passe PostgreSQL local (obligatoire)
DB_PASSWORD=

# Clé de signature JWT — 32 caractères minimum (HS256)
JWT_SECRET=

# Optionnel — valeurs par défaut : postgres / jdbc:postgresql://localhost:5432/datashare
# DB_USERNAME=
# DB_URL=
