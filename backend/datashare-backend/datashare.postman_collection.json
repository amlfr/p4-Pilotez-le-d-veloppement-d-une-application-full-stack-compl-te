    {
      "name": "Ownership & delete",
      "description": "Runs last: exercises the 403 ownership guard with a second account, then deletes the test files. The anonymous file cannot be deleted (owner-less → 403); the daily purge removes it at expiry.",
      "item": [
        {
          "name": "Register user B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User B\",\n  \"email\": \"{{testEmailB}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "description": "Second account used to prove a user cannot touch someone else's file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 (or 409 if already registered)', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('jwtB', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login user B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmailB}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "description": "Ensures {{jwtB}} is set even when Register B returned 409 on a re-run."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('jwtB', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete someone else's file (→ 403)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtB}}" }],
