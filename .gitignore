# Datashare — .gitignore unique du dépôt (backend + frontend).

# ===== Commun =====
*.log
logs
.DS_Store
.idea/
**/.vscode/*
!**/.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== Backend — Spring Boot / Maven =====
target/
!**/src/main/**/target/
!**/src/test/**/target/
**/.mvn/wrapper/maven-wrapper.jar
.env
HELP.md
# Octets des fichiers téléversés (jamais versionnés)
uploads/

# IDE Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ===== Frontend — Vite / React =====
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Sorties de tests : Cypress et couverture Vitest (`npm run coverage`)
**/cypress/screenshots/
**/cypress/videos/
**/cypress/downloads/
coverage/
