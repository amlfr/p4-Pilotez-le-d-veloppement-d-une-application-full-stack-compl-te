                  "  pm.expect(json.per_page).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My files (no token → 401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/me/files",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "files"]
            },
            "description": "Negative test (JsonAuthenticationEntryPoint): a protected endpoint without a JWT is 401 'Authentification requise' in the ErrorResponse shape."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update tags",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{fileId}}", "tags"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": [\"remplacé\", \"postman\"]\n}"
            },
            "description": "US08: full replacement of the file's tags. 200 with the normalized list."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('tags replaced', function () {",
                  "  pm.expect(pm.response.json().tags).to.eql(['remplacé', 'postman']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update tags (case-insensitive duplicate → 422)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/files/{{fileId}}/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "files", "{{fileId}}", "tags"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": [\"cours\", \"COURS\"]\n}"
            },
