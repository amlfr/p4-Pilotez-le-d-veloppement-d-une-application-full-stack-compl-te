          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', function () { pm.response.to.have.status(403); });",
                  "pm.test('French message', function () {",
                  "  pm.expect(pm.response.json().message).to.eql('Ce fichier appartient à un autre utilisateur');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete anonymous file (owner-less → 403)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
